# --- x402 ---------------------------------------------------------------
STELLAR_NETWORK=stellar:testnet
# Conta G… que recebe os pagamentos. Precisa de trustline de USDC.
STELLAR_RECIPIENT=
# Chave do facilitador. Passo manual (formulário web):
#   https://channels.openzeppelin.com/testnet/gen
OZ_API_KEY=
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet

# --- agente -------------------------------------------------------------
# Chave que assina em nome do agente. Não é dona do tesouro: assina apenas
# auth entries, e a policy decide se o pagamento cabe na procuração.
AGENT_SECRET=
# Conta corporativa (C…) de onde sai o pagamento.
CHARTER_ACCOUNT=
ED25519_VERIFIER=
CONTEXT_RULE_ID=0
# charter = paga pela smart account (default) | direct = conta clássica
CHARTER_MODE=charter

# --- deploy -------------------------------------------------------------
ADMIN_SECRET=
ACCOUNT_WASM_HASH=
