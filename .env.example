# Endereços implantados vivem em deployments/*.json e são versionados.
# Este arquivo lista só o que é segredo ou específico da máquina.
# Cópia de trabalho: .env.demo (não versionado).

# --- assinatura (servidor) ----------------------------------------------
# Fundador: paga as taxas e constitui organizações.
ADMIN_SECRET=
# Agente que assina auth entries. Não é dono do tesouro: a policy decide se o
# pagamento cabe na procuração dele.
AGENT_TRADER_SECRET=
# Chave do auditor confidencial (Grumpkin), para o console de auditoria.
AUDITOR_SK=

# --- endereços usados pelo app ------------------------------------------
CHARTER_REGISTRY=
CHARTER_GATE=
CHARTER_ORG_ACCOUNT=
CHARTER_TARGET=
CHARTER_ED25519_VERIFIER=
CHARTER_IDENTITY_VERIFIER=
CHARTER_CONTEXT_RULE_ID=0
CHARTER_CLAIM_TOPIC=1

# --- x402 (pendente: as duas chaves saem de formulário web) --------------
OZ_API_KEY=
STELLAR_RECIPIENT=
