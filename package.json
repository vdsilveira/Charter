{
  "name": "charter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Charter \u2014 a tesouraria da empresa agentificada na Stellar",
  "scripts": {
    "bootstrap:identity": "./scripts/bootstrap-identity.sh",
